After=network-online.target

[Service]
Type=oneshot
User=louiseetjulien
Environment=DB_PATH=/srv/mariage.db
EnvironmentFile=/etc/louiseetjulien/backup.env
ExecStart=/srv/louiseetjulien/deploy/backup.sh
