# Copiez ce fichier en `.env` et adaptez les valeurs.
# `.env` est ignoré par git : il contient des secrets.

# --- Base de données -------------------------------------------------------
# Chemin du fichier SQLite. En production, pointez-le vers un emplacement
# sauvegardé, hors du dossier de l'application :
#   DATABASE_URL="file:/var/lib/louiseetjulien/wedding.db"
#
# En développement sous devenv, DATABASE_URL est déjà exporté par devenv.nix
# (file:./mariage.db). dotenv n'écrase jamais une variable déjà définie : dans
# un shell devenv, c'est cette valeur-là qui gagne et la ligne ci-dessous reste
# sans effet. Changez-la dans devenv.nix, pas ici.
DATABASE_URL="file:./mariage.db"

# --- Application -----------------------------------------------------------
# URL publique du site. Sert à construire les liens d'invitation envoyés par
# email : sans elle, les liens pointeraient vers localhost.
APP_URL="http://localhost:3000"

# --- Back-office -----------------------------------------------------------
# Mot de passe unique du back-office (/admin).
ADMIN_PASSWORD="changez-moi"

# Clé de signature du cookie de session. 32 caractères aléatoires minimum.
# Générez-la avec : openssl rand -hex 32
# Obligatoire en production ; la changer déconnecte les sessions ouvertes.
SESSION_SECRET=""

# --- Envoi d'emails (facultatif) -------------------------------------------
# Sans SMTP_HOST, l'application fonctionne normalement mais aucun email ne
# part : les tentatives sont journalisées dans /admin/emails avec la raison.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # true pour du TLS implicite (port 465)
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Louise & Julien <hello@louiseetjulien.fr>"
